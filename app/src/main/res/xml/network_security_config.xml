<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed ONLY to this phone itself (the llama.cpp
  server in Termux at 127.0.0.1). All other traffic keeps Android's
  secure defaults — nothing leaves the device unencrypted.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>